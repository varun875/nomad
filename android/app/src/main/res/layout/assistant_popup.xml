<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/assistant_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#99000000">

    <!-- Bottom sheet -->
    <LinearLayout
        android:id="@+id/sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/sheet_bg"
        android:paddingTop="12dp"
        android:paddingBottom="20dp">

        <!-- Handle -->
        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="24dp"
            android:background="@drawable/handle_bg" />

        <!-- Listening indicator: 3 animated dots -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="18dp">

            <View
                android:id="@+id/dot1"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/dot_orange" />
            <View
                android:id="@+id/dot2"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/dot_amber" />
            <View
                android:id="@+id/dot3"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:background="@drawable/dot_gray" />
        </LinearLayout>

        <!-- Title -->
        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Hi, how can I help?"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="26dp" />

        <!-- Suggestion chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:scrollbars="none"
            android:layout_marginBottom="22dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/chip_talk"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/chip_bg"
                    android:drawableStart="@drawable/ic_mic"
                    android:drawablePadding="8dp"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="18dp"
                    android:text="Talk to Nomad"
                    android:textColor="#E8E8E8"
                    android:textSize="13sp"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:id="@+id/chip_open_twitter"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/chip_bg"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="Open Twitter"
                    android:textColor="#E8E8E8"
                    android:textSize="13sp"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:id="@+id/chip_open_messages"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/chip_bg"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="Open Messages"
                    android:textColor="#E8E8E8"
                    android:textSize="13sp" />

            </LinearLayout>
        </HorizontalScrollView>

        <!-- Bottom bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <TextView
                android:id="@+id/btn_keyboard"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/icon_btn_bg"
                android:gravity="center"
                android:contentDescription="Type instead"
                android:layout_marginEnd="10dp"
                android:foreground="@drawable/ic_keyboard"
                android:foregroundTint="#E8E8E8"
                android:foregroundGravity="center" />

            <TextView
                android:id="@+id/status_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Listening…"
                android:textColor="#9A9A9A"
                android:textSize="12sp"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp" />

            <TextView
                android:id="@+id/btn_close"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/icon_btn_bg"
                android:gravity="center"
                android:contentDescription="Close"
                android:foreground="@drawable/ic_close"
                android:foregroundTint="#E8E8E8" />

        </LinearLayout>

        <!-- Orange accent line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="18dp"
            android:alpha="0.7"
            android:background="#FF8C42" />

    </LinearLayout>
</FrameLayout>
